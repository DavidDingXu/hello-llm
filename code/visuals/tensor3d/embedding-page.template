<!doctype html>
<html lang="{{language}}"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title>{{title}} · Hello LLM</title><link rel="license" href="../../code/visuals/reading_site/tensor3d-LICENSE.txt">
<style>
:root{color-scheme:light;--paper:#f5f7fb;--panel:#fff;--ink:#222a35;--muted:#627082;--line:#dce3ed;--blue:#3267a4;--purple:#8056a5;--teal:#187b79;--soft:#edf3fa;--field:#f7f9fc}
:root[data-theme=dark]{color-scheme:dark;--paper:#151a22;--panel:#1d2530;--ink:#e5eaf1;--muted:#a8b5c6;--line:#364353;--blue:#99bde9;--purple:#c6a0e8;--teal:#75cbbf;--soft:#293b46;--field:#202b39}
*{box-sizing:border-box}body{margin:0;background:var(--paper);color:var(--ink);font:14px/1.5 'Hiragino Sans GB','PingFang SC','Microsoft YaHei',Arial,sans-serif}main{max-width:1220px;margin:auto;padding:12px 22px 20px}a{color:var(--teal);text-underline-offset:3px}.top{display:flex;justify-content:space-between;align-items:center;gap:10px;font-size:12px}.eyebrow{font-size:10px;letter-spacing:.1em;color:var(--muted)}h1{font-size:27px;line-height:1.25;margin:11px 0 5px;letter-spacing:-.03em}.lead{font-size:13px;color:var(--muted);margin:0 0 12px}.lab-shell{height:min(650px,calc(100svh - 123px));min-height:410px;border:1px solid var(--line);border-radius:10px;overflow:hidden;background:var(--panel);display:grid;grid-template-rows:auto minmax(0,1fr)}button,select{font:inherit;color:inherit;border:1px solid var(--line);border-radius:5px;background:var(--panel);min-height:33px}button{cursor:pointer;padding:4px 8px}button:hover{border-color:var(--teal)}button:disabled{opacity:.4;cursor:default}button[aria-pressed=true]{background:var(--soft);border-color:var(--blue);color:var(--blue)}button:focus-visible,select:focus-visible,a:focus-visible,canvas:focus-visible,summary:focus-visible{outline:3px solid var(--blue);outline-offset:2px}.toolbar{display:grid;grid-template-columns:125px 125px 1fr auto;gap:10px;align-items:end;padding:9px 13px;border-bottom:1px solid var(--line)}.control{display:flex;flex-direction:column;gap:3px;min-width:0}.control>span{font-size:10px;color:var(--muted)}.control select{width:100%;min-width:0;padding:4px 7px;font-size:12px}.features{display:flex;gap:4px}.features button{width:42px;font:12px Menlo,Consolas,monospace}.toolbar>button{font-size:11px}.workspace{display:grid;grid-template-columns:245px minmax(250px,1fr) 280px;min-height:0}.lookup{border-right:1px solid var(--line);min-height:0;overflow:auto;padding:10px 13px}.panel-title{font-size:12px;font-weight:650;margin:0}.small{font-size:10px;color:var(--muted);margin:4px 0 8px;line-height:1.6}.sample-input{margin-top:8px}.sample-label{font:10px/1.4 Menlo,Consolas,monospace;color:var(--muted);display:block;margin-bottom:4px}.token-row{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:5px}.token-row button{font:12px/1.3 Menlo,Consolas,monospace;padding:5px 2px}.token-row button small{font-size:8px;display:block;color:var(--muted);margin-bottom:3px}.token-row button.shared{border-color:var(--purple)}.token-row button[aria-pressed=true]{outline:2px solid var(--blue);outline-offset:0}.table-panel{margin-top:18px}.embedding-table{margin-top:8px;display:grid;gap:5px}.table-row{display:grid;grid-template-columns:55px 1fr 1fr;align-items:center;gap:3px;width:100%;font:12px Menlo,Consolas,monospace;text-align:center;min-height:36px;padding:3px 5px}.table-row b{font-weight:400;font-size:10px;color:var(--muted);text-align:left}.table-row span{padding:3px 0;border-radius:3px}.table-row .current-feature{outline:1px solid currentColor}.mobile-hint{display:none}.demo-note{margin:9px 0 0;font-size:9px;color:var(--muted);line-height:1.6}.scene-panel{min-width:0;min-height:0;position:relative;display:grid;grid-template-rows:auto minmax(0,1fr) auto;border-right:1px solid var(--line)}.scene-head{padding:11px 13px 3px;display:flex;flex-direction:column;gap:4px}.shape{font:11px Menlo,Consolas,monospace;color:var(--muted)}.viewport{position:relative;overflow:hidden;min-height:0}.viewport canvas{display:block;width:100%;height:100%;touch-action:pan-y;outline-offset:-3px}.viewport.is-orbit canvas{touch-action:none;cursor:grab}.viewport.is-orbit canvas:active{cursor:grabbing}.view-tools{padding:4px 12px 9px;display:flex;flex-wrap:wrap;align-items:center;gap:6px}.view-tools button{font-size:10px;min-height:29px;padding:3px 7px}.axis-note{font-size:10px;line-height:1.5;color:var(--muted);margin:3px 0 0;flex-basis:100%}.fixed-note{font-size:9px;color:var(--muted);margin-right:auto}.inspector{min-width:0;min-height:0;overflow:auto;padding:11px 13px}.readout{background:var(--field);border:1px solid var(--line);border-radius:6px;padding:10px;margin-bottom:13px}.address{font:10px/1.5 Menlo,Consolas,monospace;overflow-wrap:anywhere}.readout-main{display:flex;align-items:center;justify-content:space-between;gap:8px}.value{font:650 36px/1.3 Menlo,Consolas,monospace;color:var(--blue)}.vector{font:12px Menlo,Consolas,monospace;color:var(--purple)}.repeat-note{font-size:10px;color:var(--muted);margin:6px 0 0;line-height:1.6}.output-batches{display:grid;gap:11px;margin-top:8px}.output-sample{min-width:0}.output-sample h3{font:11px/1.4 Menlo,Consolas,monospace;color:var(--muted);margin:0 0 5px}.output-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:4px}.out-cell{display:flex;align-items:center;justify-content:space-between;gap:5px;font:14px Menlo,Consolas,monospace;min-height:34px;padding:4px 7px}.out-cell small{font-size:8px;color:var(--muted)}.out-cell.shared{border-color:var(--purple);color:var(--purple)}.out-cell[aria-pressed=true]{outline:2px solid var(--blue);outline-offset:0;color:var(--blue);font-weight:700}.unchanged{font-size:9px;color:var(--muted);margin:10px 0 0}.fallback{display:none;padding:10px 14px}.fallback p{font-size:10px;color:var(--muted);margin:0 0 8px}.fallback-batches{display:grid;grid-template-columns:1fr 1fr;gap:12px}.viewport.failed canvas{display:none}.viewport.failed .fallback{display:flex;flex-direction:column;justify-content:center;height:100%}.source-note{font-size:11px;color:var(--muted);margin-top:11px;line-height:1.7}.source-note summary{cursor:pointer}.source-note p{margin:6px 0}.source-note h2{font-size:12px;margin:12px 0 6px}.vocab-row{display:flex;flex-wrap:wrap;gap:6px}.vocab-row button{font-size:12px;min-width:48px}.source-links{display:flex;flex-wrap:wrap;gap:10px 18px}.sr-only{position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;border:0}
@media(max-width:850px){.workspace{grid-template-columns:210px minmax(220px,1fr) 235px}.lookup,.inspector{padding-inline:10px}.table-row{grid-template-columns:44px 1fr 1fr}}
@media(max-width:700px){main{padding:9px 12px 16px}.top{font-size:10px}.eyebrow{font-size:8px}h1{font-size:23px;margin:9px 0 5px}.lead{font-size:11px;margin-bottom:9px}.lab-shell{height:calc(100svh - 120px);max-height:780px;min-height:470px}.toolbar{grid-template-columns:1fr 1fr auto auto;gap:6px;padding:7px 9px}.control>span{font-size:9px}.control select{min-height:31px;font-size:10px;padding:4px}.features button{width:28px;font-size:10px;min-height:31px;padding:3px}.toolbar>button{font-size:10px;min-height:31px;padding:3px 6px}.workspace{grid-template-columns:1fr;grid-template-rows:145px minmax(130px,1fr) 159px}.lookup{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1.12fr);gap:10px;border-right:0;border-bottom:1px solid var(--line);padding:6px 9px;overflow:hidden}.panel-title{font-size:10px;line-height:1.4}.small{font-size:8px;line-height:1.4;margin:3px 0 4px}.sample-input{margin-top:5px}.sample-label{font-size:8px;margin-bottom:3px}.token-row{gap:3px}.token-row button{min-height:30px;font-size:10px;padding:3px 1px}.token-row button small{font-size:7px;margin-bottom:1px}.table-panel{margin:0}.embedding-table{margin-top:4px;gap:3px}.table-row{grid-template-columns:34px 1fr 1fr;min-height:24px;font-size:10px;padding:2px 4px}.table-row b{font-size:8px}.table-row span{padding:1px}.table-hint{display:none}.mobile-hint{display:inline;font-size:8px;font-weight:400;color:var(--muted);margin-left:4px}.demo-note{display:none}.scene-panel{border-right:0;border-bottom:1px solid var(--line);grid-template-rows:minmax(0,1fr)}.scene-head{position:absolute;top:4px;left:9px;z-index:2;pointer-events:none;padding:0;gap:1px}.scene-head .panel-title{font-size:9px}.shape{font-size:8px}.viewport{grid-row:1}.view-tools{position:absolute;left:8px;right:8px;bottom:3px;padding:0;z-index:2;gap:4px}.view-tools button{font-size:8px;min-height:25px;padding:2px 5px}.fixed-note{font-size:8px}.axis-note{display:none}.inspector{padding:6px 9px;overflow:hidden;display:grid;grid-template-rows:auto minmax(0,1fr);grid-template-columns:1fr;gap:5px}.readout{padding:4px 7px;margin:0;display:grid;grid-template-columns:minmax(0,1fr) auto;align-items:center;gap:4px}.address{font-size:9px}.readout-main{gap:6px}.value{font-size:23px}.vector{font-size:9px}.repeat-note{display:none}.output-title{display:none}.output-batches{grid-template-columns:1fr 1fr;gap:12px;margin:0}.output-sample h3{font-size:8px;margin-bottom:3px}.output-grid{gap:3px}.out-cell{font-size:11px;min-height:25px;padding:2px 5px}.out-cell small{font-size:7px}.unchanged{display:none}.source-note{font-size:10px}.fallback{padding:31px 10px 28px}.fallback p{display:block;font-size:9px;line-height:1.4}.fallback-batches{gap:10px}.fallback .output-grid{gap:2px}.fallback .out-cell{min-height:22px;font-size:10px}.fallback .output-sample h3{font-size:8px}}
@media(max-height:650px){main{padding-top:8px}.top{font-size:10px}h1{font-size:21px;margin:7px 0 9px}.lead{display:none}.lab-shell{height:calc(100svh - 81px);max-height:none;min-height:410px}.toolbar{padding-block:6px}.readout{margin-bottom:8px}.repeat-note{display:none}.value{font-size:24px}.source-note{margin-top:9px}}
@media(max-width:700px) and (max-height:650px){.lab-shell{min-height:470px}.workspace{grid-template-rows:139px minmax(120px,1fr) 154px}.toolbar{gap:5px;padding-inline:8px}.scene-head{top:3px}.lookup{padding-block:5px}.table-row{min-height:23px}.output-batches{gap:9px}.out-cell{min-height:24px}.inspector{gap:4px}.value{font-size:21px}.fallback{padding-top:29px}.fallback p{display:none}.fallback .out-cell{min-height:20px}}
@media(prefers-reduced-motion:reduce){*{scroll-behavior:auto!important}}
</style></head><body><main id="lab" data-render-state="loading">
<nav class="top"><a href="{{article}}">{{back}}</a><span class="eyebrow">{{eyebrow}}</span></nav>
<header><h1>{{title}}</h1><p class="lead">{{lead}}</p></header>
<section class="lab-shell" aria-label="{{title}}"><div class="toolbar">
<label class="control"><span>{{batch}}</span><select id="batch"><option>0</option><option>1</option></select></label>
<label class="control"><span>{{position}}</span><select id="position"><option>0</option><option>1</option><option>2</option></select></label>
<div class="control"><span>{{feature}}</span><div class="features" aria-label="{{feature}}"><button id="feature-0" type="button" aria-pressed="true">0</button><button id="feature-1" type="button" aria-pressed="false">1</button></div></div>
<button id="reset" type="button">{{reset}}</button></div>
<div class="workspace"><section class="lookup" aria-label="{{inputs}}">
<div class="input-panel"><h2 class="panel-title">{{inputs}}</h2><p class="small">{{inputShape}}</p><div id="input-samples"></div><p class="demo-note">{{demoNote}}</p></div>
<div class="table-panel"><h2 class="panel-title">{{table}}<span class="mobile-hint">{{tableHintShort}}</span></h2><p class="small table-hint">{{tableHint}}</p><div class="embedding-table" id="table"></div></div></section>
<section class="scene-panel" aria-label="{{scene}}"><div class="scene-head"><h2 class="panel-title">{{scene}}</h2><span class="shape">{{shape}}</span></div>
<div class="viewport" id="viewport"><canvas id="scene" tabindex="0" aria-label="{{scene}}" aria-describedby="keyboard-help"></canvas><div class="fallback"><p>{{fallback}}</p><div class="fallback-batches" id="fallback-cells"></div></div></div>
<div class="view-tools"><span class="fixed-note">{{fixed}}</span><button id="orbit" type="button" aria-pressed="false">{{orbit}}</button><button id="reset-view" type="button">{{resetView}}</button><p class="axis-note">{{axisNote}}</p></div></section>
<section class="inspector" aria-label="{{output}}"><div class="readout"><div><span class="sr-only">{{coordinate}}</span><div class="address" id="address"></div><p class="repeat-note" id="repeat-note"></p></div><div class="readout-main"><span class="value" id="value"></span><span class="vector" id="vector"></span></div></div>
<div><h2 class="panel-title output-title">{{output}} <small class="small">{{outputAxis}}</small></h2><div class="output-batches" id="output-cells"></div><p class="unchanged">{{unchanged}}</p></div></section></div></section>
<p class="sr-only" id="keyboard-help">{{keyboard}}</p><p class="sr-only" role="status" aria-live="polite" id="status"></p>
<details class="source-note"><summary>{{source}}</summary><p>{{sourceText}}</p><p>{{demoNote}}</p><p>{{axisNote}}</p><h2>{{vocabulary}}</h2><div id="vocab" class="vocab-row"></div><p id="vocab-status">{{vocabStatus}}</p><p>{{vocabNote}}</p><p class="source-links"><a href="{{staticPath}}">{{staticLink}}</a><a href="../../code/artifacts/lessons/l07.json">{{dataLink}}</a></p></details>
</main><script type="application/json" id="embedding-data">{{payload}}</script><script src="../../code/visuals/reading_site/embedding3d.js"></script></body></html>
