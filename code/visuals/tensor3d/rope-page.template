<!doctype html><html lang="{{language}}"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>{{title}} · Hello LLM</title><link rel="license" href="../../code/visuals/reading_site/tensor3d-LICENSE.txt">
<style>
:root{color-scheme:light;--paper:#f5f7fb;--panel:#fff;--ink:#222a35;--muted:#627082;--line:#dce3ed;--blue:#3267a4;--purple:#8056a5;--teal:#187b79;--soft:#edf3fa;--field:#f7f9fc}:root[data-theme=dark]{color-scheme:dark;--paper:#151a22;--panel:#1d2530;--ink:#e5eaf1;--muted:#a8b5c6;--line:#364353;--blue:#99bde9;--purple:#c6a0e8;--teal:#75cbbf;--soft:#293b46;--field:#202b39}
*{box-sizing:border-box}body{margin:0;background:var(--paper);color:var(--ink);font:14px/1.5 'Hiragino Sans GB','PingFang SC','Microsoft YaHei',Arial,sans-serif}main{max-width:1220px;margin:auto;padding:14px 22px 20px}a{color:var(--teal);text-underline-offset:3px}.top{display:flex;justify-content:space-between;align-items:center;gap:12px;font-size:12px}.eyebrow{color:var(--muted);font-size:10px;letter-spacing:.1em}h1{font-size:27px;line-height:1.2;margin:12px 0 6px;letter-spacing:-.03em}.lead{font-size:13px;color:var(--muted);margin:0 0 13px}.lab-shell{height:min(650px,calc(100svh - 129px));min-height:430px;border:1px solid var(--line);border-radius:10px;background:var(--panel);overflow:hidden;display:grid;grid-template-rows:auto minmax(0,1fr)}button,input{font:inherit;color:inherit;background:var(--panel);border:1px solid var(--line);border-radius:5px;min-height:34px}button{cursor:pointer;padding:5px 10px}button:hover{border-color:var(--teal)}button:disabled{opacity:.35;cursor:default}button[aria-pressed=true],button[aria-selected=true]{background:var(--soft);color:var(--teal);border-color:var(--teal)}button:focus-visible,input:focus-visible,a:focus-visible,canvas:focus-visible,summary:focus-visible,[tabindex]:focus-visible{outline:3px solid var(--blue);outline-offset:2px}.toolbar{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr) auto;align-items:center;gap:18px;padding:11px 14px;border-bottom:1px solid var(--line)}.position-control{display:grid;grid-template-columns:minmax(0,1fr) 52px;align-items:center;gap:0 7px}.position-control label{font-size:11px;color:var(--muted)}.position-control input[type=number]{width:52px;text-align:center;font:13px Menlo,Consolas,monospace;padding:3px}.position-control input[type=range]{grid-column:1/3;width:100%;min-width:0;min-height:22px;accent-color:var(--blue);border:0;background:transparent;margin:3px 0 0}.position-control.k input[type=range]{accent-color:var(--teal)}.action-controls{display:flex;gap:5px;flex-wrap:wrap;justify-content:flex-end}.action-controls button{font-size:11px;padding:5px 8px;min-height:33px}.workspace{display:grid;grid-template-columns:minmax(0,1.1fr) minmax(350px,1fr);min-height:0}.scene-panel{position:relative;display:grid;grid-template-rows:auto minmax(0,1fr) auto auto;border-right:1px solid var(--line);min-height:0}.scene-head{display:flex;align-items:center;justify-content:space-between;gap:7px;padding:10px 12px 4px}.segmented{display:flex;gap:4px}.segmented button{font-size:11px;min-height:31px;padding:4px 8px}.shape{font:11px Menlo,Consolas,monospace;color:var(--muted)}.viewport{position:relative;min-height:0;overflow:hidden}.viewport canvas{display:block;width:100%;height:100%;touch-action:pan-y;outline-offset:-3px}.viewport.is-orbit canvas{touch-action:none;cursor:grab}.viewport.is-orbit canvas:active{cursor:grabbing}.fallback{display:none;width:100%;height:100%;min-height:0}.fallback svg{display:block;width:100%;height:100%;color:var(--ink)}.viewport.failed canvas{display:none}.viewport.failed .fallback{display:block}.view-tools{padding:4px 12px;display:flex;align-items:center;justify-content:space-between;gap:8px}.view-tools button{font-size:11px;min-height:30px;padding:4px 8px}.guide{font-size:9px;color:var(--muted)}.scope{font-size:10px;color:var(--muted);padding:5px 12px 10px;margin:0}.inspector{display:grid;grid-template-rows:auto auto minmax(0,1fr);min-height:0;overflow:hidden}.readout{padding:12px 15px 10px;background:var(--field);border-bottom:1px solid var(--line)}.readout-top{display:flex;align-items:center;justify-content:space-between;gap:10px;color:var(--muted);font-size:10px}.readout-value{font:600 32px/1.25 Menlo,Consolas,monospace;letter-spacing:-.04em;color:var(--blue);margin:4px 0}.equation{font:11px/1.6 Menlo,Consolas,monospace;overflow-wrap:anywhere}.v-line{font-size:10px;color:var(--teal);margin:5px 0 0}.raw-note{font-size:9px;color:var(--muted);margin:5px 0 0}.tablist{display:flex;border-bottom:1px solid var(--line);padding:5px 10px;gap:4px}.tablist button{flex:1;min-height:32px;padding:5px 7px;font-size:11px}.tab-panel{padding:11px 14px;overflow:auto;min-height:0;overscroll-behavior:contain;scrollbar-width:thin}.tab-panel[hidden]{display:none}.panel-note{font-size:11px;color:var(--muted);margin:0 0 9px;line-height:1.7}.pair-controls{display:flex;gap:5px;margin-bottom:10px}.pair-controls button{flex:1;min-width:0;font-size:11px;padding:5px}.pair-title{display:flex;justify-content:space-between;align-items:center;gap:8px;font-size:11px;color:var(--muted);margin:0 0 7px}.pair-title code{font:12px Menlo,Consolas,monospace;color:var(--purple)}.coordinate-card{border:1px solid var(--line);border-left:3px solid var(--blue);border-radius:4px;padding:9px 10px;margin:6px 0;font-size:11px}.coordinate-card.k{border-left-color:var(--teal)}.coordinate-card .angle{display:flex;justify-content:space-between;gap:8px;color:var(--muted);font:10px Menlo,Consolas,monospace}.coordinate-card code{display:block;font:12px/1.8 Menlo,Consolas,monospace;overflow-wrap:anywhere;margin-top:3px}.detail-equation{font:11px/1.8 Menlo,Consolas,monospace;background:var(--field);border-radius:4px;padding:8px;overflow-wrap:anywhere;margin:7px 0;white-space:pre-line}.comparison-grid{display:grid;grid-template-columns:1fr 1fr;gap:7px}.comparison-card{padding:10px;border:1px solid var(--line);border-radius:5px;font-size:10px;color:var(--muted)}.comparison-card b{display:block;color:var(--ink);font:600 18px/1.6 Menlo,Consolas,monospace}.comparison-card span{display:block;font:10px/1.7 Menlo,Consolas,monospace}.comparison-result{font-size:11px;color:var(--teal);margin:10px 0 7px}.comparison-error{font:11px Menlo,Consolas,monospace;margin:8px 0}.frequency-table{width:100%;border-collapse:collapse;font-size:11px}.frequency-table th{color:var(--muted);font-weight:400;text-align:left}.frequency-table td,.frequency-table th{padding:6px 4px;border-bottom:1px solid var(--line)}.frequency-table td:last-child{font:11px Menlo,Consolas,monospace}.source-note{color:var(--muted);font-size:11px;margin-top:13px}.source-note summary{cursor:pointer}.source-note p{line-height:1.7;margin:7px 0}.source-note code{font:10px Menlo,Consolas,monospace;overflow-wrap:anywhere}.sr-only{position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;border:0}
@media(max-width:700px){main{padding:10px 12px 16px}h1{font-size:22px;margin:10px 0 5px}.lead{font-size:11px;margin-bottom:10px}.lab-shell{height:calc(100svh - 130px);min-height:490px;max-height:800px}.toolbar{grid-template-columns:1fr 1fr;gap:6px 16px;padding:8px 10px}.position-control{grid-template-columns:minmax(0,1fr) 36px;gap:0 5px}.position-control label{font-size:10px}.position-control input[type=number]{width:36px;min-height:28px;font-size:11px;padding:2px;-moz-appearance:textfield}.position-control input::-webkit-inner-spin-button{-webkit-appearance:none}.position-control input[type=range]{min-height:19px;margin-top:0}.action-controls{grid-column:1/3;justify-content:stretch;gap:5px}.action-controls button{flex:1;font-size:9px;padding:4px 5px;min-height:29px}.workspace{grid-template-columns:1fr;grid-template-rows:minmax(155px,.43fr) minmax(230px,.57fr)}.scene-panel{grid-template-rows:minmax(0,1fr);border-right:0;border-bottom:1px solid var(--line)}.scene-panel .viewport{grid-column:1;grid-row:1}.scene-head{position:absolute;top:0;left:0;right:0;z-index:2;padding:6px 10px 2px}.segmented button{min-height:28px;font-size:9px;padding:3px 6px}.shape{font-size:9px}.view-tools{position:absolute;bottom:0;left:0;right:0;z-index:2;padding:3px 10px 5px}.view-tools button{min-height:27px;font-size:9px;padding:3px 6px}.guide{font-size:8px;max-width:120px;text-align:right}.scope{display:none}.readout{padding:8px 11px}.readout-top{font-size:9px}.readout-value{font-size:27px;margin:2px 0}.equation{font-size:9px}.v-line{font-size:9px;margin-top:3px}.raw-note{display:none}.tablist{padding:4px 7px;gap:4px}.tablist button{font-size:10px;min-height:29px;padding:3px 5px}.tab-panel{padding:8px 10px}.pair-controls{gap:4px;margin-bottom:7px}.pair-controls button{font-size:9px;min-height:29px;padding:4px}.pair-title{font-size:10px}.pair-title code{font-size:10px}.coordinate-card{padding:6px 7px;margin:5px 0}.coordinate-card .angle{font-size:9px}.coordinate-card code{font-size:10px}.detail-equation{font-size:9px;padding:6px;line-height:1.7}.panel-note{font-size:10px}.comparison-card{padding:7px}.comparison-card b{font-size:15px}.source-note{font-size:10px}}
@media(max-height:650px){main{padding-top:8px}.top{font-size:10px}h1{font-size:21px;margin:7px 0 8px}.lead{display:none}.lab-shell{height:calc(100svh - 82px);min-height:350px;max-height:none}.toolbar{padding-top:7px;padding-bottom:7px}.readout{padding-top:8px;padding-bottom:7px}.readout-value{font-size:25px}.raw-note{display:none}.source-note{margin-top:9px}}
@media(max-width:700px) and (max-height:650px){h1{font-size:19px}.lab-shell{min-height:430px}.workspace{grid-template-rows:minmax(135px,.42fr) minmax(195px,.58fr)}.toolbar{gap:4px 14px;padding:6px 10px}.position-control input[type=range]{min-height:17px}.action-controls button{min-height:27px}.guide{display:none}.v-line{font-size:8px}.readout{padding:6px 10px}.readout-value{font-size:24px}.scene-head{padding-top:4px}}
@media(prefers-reduced-motion:reduce){*{scroll-behavior:auto!important}}
</style></head><body><main id="lab" data-render-state="loading"><nav class="top"><a href="{{article}}">{{back}}</a><span class="eyebrow">{{eyebrow}}</span></nav><header><h1>{{title}}</h1><p class="lead">{{lead}}</p></header>
<section class="lab-shell" aria-label="{{title}}"><div class="toolbar"><div class="position-control"><label for="position-m">{{positionQ}}</label><input id="position-m" type="number" min="0" max="{{maximum}}" value="1"><input id="range-m" type="range" min="0" max="{{maximum}}" value="1" aria-label="{{positionQ}}"></div><div class="position-control k"><label for="position-n">{{positionK}}</label><input id="position-n" type="number" min="0" max="{{maximum}}" value="0"><input id="range-n" type="range" min="0" max="{{maximum}}" value="0" aria-label="{{positionK}}"></div><div class="action-controls"><button id="common-shift">{{common}}</button><button id="only-k">{{onlyK}}</button><button id="reset">{{reset}}</button></div></div>
<div class="workspace"><section class="scene-panel" aria-label="{{scene}}"><div class="scene-head"><div class="segmented"><button id="both" aria-pressed="true">{{planes}}</button><button id="focus" aria-pressed="false">{{focus}}</button></div><span class="shape">d = 4 → 4</span></div><div id="viewport" class="viewport"><canvas id="scene" tabindex="0" aria-label="{{scene}}"></canvas><div class="fallback" id="fallback"></div></div><div class="view-tools"><div class="segmented"><button id="orbit" aria-pressed="false">{{orbit}}</button><button id="reset-view">{{resetView}}</button></div><span class="guide">{{guide}}</span></div><p class="scope">{{scope}}</p></section>
<section class="inspector" aria-label="{{rawDot}}"><div class="readout" aria-live="polite"><div class="readout-top"><span>{{rawDot}}</span><span id="position-difference">n−m = −1</span></div><div id="score" class="readout-value"></div><div id="score-equation" class="equation"></div><p class="v-line">{{unchanged}} <code id="v-values">[1,0,1,0] → [1,0,1,0]</code></p><p class="raw-note">{{rawNote}}</p></div>
<div class="tablist" role="tablist"><button id="tab-coordinates" role="tab" aria-selected="true" aria-controls="panel-coordinates">{{coordinates}}</button><button id="tab-comparison" role="tab" aria-selected="false" aria-controls="panel-comparison" tabindex="-1">{{comparison}}</button><button id="tab-formal" role="tab" aria-selected="false" aria-controls="panel-formal" tabindex="-1">{{formal}}</button></div>
<div id="panel-coordinates" class="tab-panel" role="tabpanel" aria-labelledby="tab-coordinates"><div class="pair-controls"><button id="pair-0" aria-pressed="true">{{pair0}}</button><button id="pair-1" aria-pressed="false">{{pair1}}</button></div><div class="pair-title"><span id="pair-title"></span><code id="frequency"></code></div><div class="coordinate-card"><div class="angle"><span id="q-angle"></span><span>Q</span></div><code id="q-coordinates"></code></div><div class="coordinate-card k"><div class="angle"><span id="k-angle"></span><span>K</span></div><code id="k-coordinates"></code></div><div id="pair-equation" class="detail-equation"></div><p id="norms" class="panel-note"></p></div>
<div id="panel-comparison" class="tab-panel" role="tabpanel" aria-labelledby="tab-comparison" hidden><p id="comparison-empty" class="panel-note">{{comparisonEmpty}}</p><div id="comparison-values" hidden><div class="comparison-grid"><div class="comparison-card">{{before}}<b id="before-score"></b><span id="before-position"></span><span id="before-pairs"></span></div><div class="comparison-card">{{after}}<b id="after-score"></b><span id="after-position"></span><span id="after-pairs"></span></div></div><p id="comparison-result" class="comparison-result"></p><div id="comparison-error" class="comparison-error"></div><p class="panel-note">{{locked}}</p></div></div>
<div id="panel-formal" class="tab-panel" role="tabpanel" aria-labelledby="tab-formal" hidden><p class="panel-note">{{formalNote}}</p><table class="frequency-table"><thead><tr><th>{{pair}}</th><th>{{dimension}}</th><th>ωᵢ</th></tr></thead><tbody id="frequency-table"></tbody></table></div></section></div></section>
<details class="source-note"><summary>{{detail}}</summary><p>{{scope}} {{rawNote}}</p><p><code>Q = K = [1,0,1,0]</code> · {{unchanged}} <code>[1,0,1,0]</code></p><p>{{formula}}</p><p>{{caveat}}</p><p>{{source}}</p><p><a href="../../code/artifacts/lessons/l13.json">l13.json</a> · <a href="../../code/tiny_lm/rope.py">tiny_lm/rope.py</a> · <a href="../../code/tiny_lm/model.py">ModelConfig</a> · <a href="{{staticPath}}">{{staticLink}}</a></p></details><p class="sr-only" id="status" role="status"></p><noscript><p>{{noScript}} <a href="{{staticPath}}">{{staticLink}}</a></p></noscript></main><script id="rope-data" type="application/json">{{payload}}</script><script src="../../code/visuals/reading_site/rope3d.js" defer></script></body></html>
