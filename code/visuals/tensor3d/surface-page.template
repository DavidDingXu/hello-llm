<!doctype html>
<html lang="{{language}}"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title>{{title}} · Hello LLM</title><link rel="license" href="../../code/visuals/reading_site/tensor3d-LICENSE.txt">
<style>
:root{color-scheme:light;--paper:#f5f7fa;--panel:#fff;--ink:#222a35;--muted:#606c7b;--line:#dce3eb;--teal:#187b79;--blue:#3267a4;--soft:#eef5f7;--purple:#8056a5}
:root[data-theme=dark]{color-scheme:dark;--paper:#151a22;--panel:#1d2530;--ink:#e5eaf1;--muted:#a8b5c6;--line:#364353;--teal:#75cbbf;--blue:#99bde9;--soft:#253943;--purple:#cbb0e1}
*{box-sizing:border-box}body{margin:0;background:var(--paper);color:var(--ink);font:15px/1.5 'Hiragino Sans GB','PingFang SC','Microsoft YaHei',Arial,sans-serif}main{max-width:1200px;margin:auto;padding:16px 20px 22px}a{color:var(--teal);text-underline-offset:3px}.top{display:flex;justify-content:space-between;gap:12px;font-size:11px;color:var(--muted);margin-bottom:8px}h1{font-size:27px;line-height:1.2;margin:0 0 7px;letter-spacing:-.025em}.formula{font:14px/1.5 Menlo,Consolas,monospace;color:var(--purple);margin:0 0 12px;overflow-wrap:anywhere}.workspace{display:grid;grid-template-columns:minmax(0,1.4fr) minmax(300px,.8fr);gap:18px;align-items:start}.scene-panel,.control-panel{border:1px solid var(--line);border-radius:7px;background:var(--panel);min-width:0}.viewport{position:relative;height:clamp(280px,calc(100dvh - 210px),490px);overflow:hidden}canvas{display:block;width:100%;height:100%;touch-action:pan-y;outline-offset:-4px}.viewport.is-orbit canvas{cursor:grab;touch-action:none}.view-tools{position:absolute;top:8px;right:8px;display:flex;gap:5px}.view-tools button{background:var(--panel);font-size:11px;padding:5px 7px;min-height:29px}.legend{display:flex;flex-wrap:wrap;gap:4px 14px;padding:5px 11px 9px;font-size:11px;color:var(--muted)}.legend span:before{content:'';display:inline-block;width:12px;height:3px;vertical-align:middle;margin-right:5px;background:var(--legend)}.control-panel{padding:13px}.stats{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:8px;margin-bottom:14px}.stat small{display:block;font-size:11px;color:var(--muted)}.stat output{display:block;font:600 24px/1.4 Menlo,Consolas,monospace;color:var(--teal);overflow-wrap:anywhere}.parameters{display:grid;grid-template-columns:1fr 1fr;gap:13px;margin-bottom:12px}.parameter{min-width:0}.parameter-head{display:flex;align-items:center;justify-content:space-between;gap:6px;font-size:13px}.parameter-head label{white-space:nowrap}.parameter input[type=number]{width:85px;min-width:0}.parameter input[type=range]{display:block;width:100%;accent-color:var(--purple);height:25px;margin:6px 0 0;cursor:pointer}button,input,select{font:inherit;color:inherit}button,select,input[type=number]{min-height:34px;border:1px solid var(--line);border-radius:4px;background:var(--panel);padding:5px 8px}button{cursor:pointer;font-size:13px}button:hover{border-color:var(--teal)}button.primary{background:var(--teal);border-color:var(--teal);color:var(--panel)}button[aria-pressed=true]{border-color:var(--teal);color:var(--teal);background:var(--soft)}button:disabled{opacity:.45;cursor:default}button:focus-visible,input:focus-visible,select:focus-visible,a:focus-visible,summary:focus-visible{outline:3px solid var(--blue);outline-offset:3px}.actionbar{display:grid;grid-template-columns:77px 1fr 1fr 34px;gap:6px;align-items:end}.rate{font-size:11px;color:var(--muted)}.rate span{display:block;margin-bottom:3px}.rate select{width:100%;color:var(--ink);padding:5px}.reset{font-size:20px;padding:2px;line-height:1}.gradient{font:11px/1.6 Menlo,Consolas,monospace;color:var(--muted);margin:11px 0 8px;overflow-wrap:anywhere}.message{background:var(--soft);border:1px solid var(--line);padding:9px 10px;margin:0;min-height:65px;max-height:110px;overflow:auto;font-size:13px}.details{border-top:1px solid var(--line);margin-top:12px;font-size:13px}.details>summary{padding:8px 0;cursor:pointer;color:var(--teal)}.details-content{max-height:48dvh;overflow:auto;padding:2px 2px 12px;overscroll-behavior:contain}.details-content p{margin:7px 0 13px}.details-content h2{font-size:14px;margin:15px 0 7px}.domain{font:11px/1.6 Menlo,Consolas,monospace;overflow-wrap:anywhere}.table-wrap{max-width:100%;overflow:auto}table{width:100%;border-collapse:collapse;font-size:12px}th,td{text-align:left;white-space:nowrap;padding:6px 8px;border-bottom:1px solid var(--line);font-variant-numeric:tabular-nums}.fallback{display:none;padding:10px;text-align:center;font-size:12px;color:var(--muted)}.fallback img{max-width:100%;max-height:180px;object-fit:contain}.viewport.failed canvas{display:none}.viewport.failed .fallback{display:block}.viewport.failed .view-tools{display:none}.fallback p{margin:5px 0}noscript p{font-size:13px}
@media(max-width:700px){main{padding:10px 12px 16px}.top{font-size:10px;margin-bottom:5px}.top>span{font-size:9px}h1{font-size:21px;margin-bottom:4px}.formula{font-size:11px;line-height:1.4;margin-bottom:7px}.workspace{display:flex;flex-direction:column;gap:7px}.scene-panel,.control-panel{width:100%}.viewport{height:clamp(145px,26dvh,250px)}.view-tools{top:5px;right:5px}.view-tools button{font-size:10px;min-height:27px;padding:4px 6px}.legend{font-size:9px;gap:3px 9px;padding:3px 7px 6px}.legend span:before{width:10px;margin-right:4px}.control-panel{padding:8px}.stats{gap:7px;margin-bottom:7px}.stat small{font-size:10px}.stat output{font-size:20px;line-height:1.3}.parameters{gap:12px;margin-bottom:6px}.parameter-head{font-size:12px}.parameter input[type=number]{width:75px;font-size:12px;min-height:28px;padding:3px 5px}.parameter input[type=range]{height:22px;margin-top:1px}.actionbar{grid-template-columns:65px 1fr 1.15fr 30px;gap:5px}.actionbar button{min-height:31px;font-size:11px;padding:5px}.actionbar .reset{font-size:20px;padding:1px}.rate{font-size:10px}.rate span{position:absolute;width:1px;height:1px;clip-path:inset(50%);overflow:hidden}.rate select{min-height:31px;font-size:12px}.gradient{font-size:10px;margin:6px 0}.message{font-size:11px;line-height:1.4;min-height:39px;max-height:51px;padding:6px 7px}.details{margin-top:7px;font-size:12px}.details>summary{font-size:11px;padding:6px 0}.details-content{max-height:42dvh}.fallback{padding:5px}.fallback img{max-height:90px}.fallback p{font-size:10px;margin:3px 0}}
@media(max-height:620px) and (min-width:701px){main{padding-top:10px}h1{font-size:24px}.top{margin-bottom:5px}.formula{margin-bottom:8px}.viewport{height:calc(100dvh - 235px);min-height:250px}.control-panel{padding:10px}.stats{margin-bottom:10px}.message{min-height:50px}}
@media(prefers-reduced-motion:reduce){*{scroll-behavior:auto!important}}
</style></head><body>
<main id="surface-lab" data-render-state="loading"><nav class="top"><a href="{{article}}">← {{back}}</a><span>{{eyebrow}}</span></nav><h1>{{title}}</h1><p class="formula">{{formula}}</p>
<div class="workspace"><section class="scene-panel" aria-label="{{scene}}"><div class="viewport" id="surface-viewport"><canvas id="surface-scene" tabindex="0" aria-label="{{scene}}"></canvas><div class="view-tools"><button id="orbit" aria-pressed="false">{{orbit}}</button><button id="reset-view">{{resetView}}</button></div><div class="fallback"><img src="{{staticPath}}" alt="{{scene}}"><p>{{fallback}}</p></div></div><div class="legend"><span style="--legend:#ae96c8">{{legendSurface}}</span><span style="--legend:#5086c5">{{legendSlice}}</span><span style="--legend:#23998a">{{legendPath}}</span><span style="--legend:#df6371">{{legendPoint}}</span><span style="--legend:#c39129">{{legendGradient}}</span></div></section>
<section class="control-panel" aria-label="{{details}}"><div class="stats"><div class="stat"><small>{{prediction}}</small><output id="prediction">2</output></div><div class="stat"><small>{{loss}}</small><output id="loss">16</output></div><div class="stat"><small>{{updates}}</small><output id="updates">0</output></div></div>
<div class="parameters"><div class="parameter"><div class="parameter-head"><label for="w">{{weight}}</label><input id="w" type="number" step="any" value="1" aria-label="{{weight}}"></div><input id="w-range" type="range" min="0" max="4" value="1" step="any" aria-label="{{weight}}"></div><div class="parameter"><div class="parameter-head"><label for="b">{{bias}}</label><input id="b" type="number" step="any" value="0" aria-label="{{bias}}"></div><input id="b-range" type="range" min="-1" max="3" value="0" step="any" aria-label="{{bias}}"></div></div>
<div class="actionbar"><label class="rate" for="learning-rate"><span>{{rate}} η</span><select id="learning-rate" aria-label="{{rate}}"><option value="0.1">η 0.1</option><option value="0.3">η 0.3</option></select></label><button id="weight-step">{{only}}</button><button id="both-step" class="primary">{{both}}</button><button id="reset" class="reset" aria-label="{{reset}}" title="{{reset}}">↺</button></div><p class="gradient" id="gradient"></p><p class="message" id="change" role="status" aria-live="polite">{{start}}</p></section></div>
<details class="details"><summary>{{details}}</summary><div class="details-content" tabindex="0"><p>{{about}}</p><p>{{pathNote}}</p><p>{{rateNote}}</p><p>{{interactionNote}}</p><h2>{{domain}}</h2><output id="domain" class="domain"></output><h2>{{updates}}</h2><div class="table-wrap"><table><thead><tr><th>{{historyStep}}</th><th>{{historyMode}}</th><th>{{historyPoint}}</th><th>{{historyLoss}}</th></tr></thead><tbody id="history"></tbody></table></div><p id="empty-history">{{historyEmpty}}</p><p>{{source}} · <a href="{{staticPath}}">{{staticLink}} ↗</a></p></div></details>
<noscript><p>{{noScript}} <a href="{{staticPath}}">{{staticLink}}</a></p><style>.view-tools{display:none}</style></noscript></main>
<script id="surface-data" type="application/json">{{payload}}</script><script src="../../code/visuals/reading_site/surface3d.js" defer onerror="document.getElementById('surface-viewport').classList.add('failed');document.getElementById('surface-lab').dataset.renderState='fallback'"></script>
</body></html>
