<!doctype html>
<html lang="{{language}}"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title>{{title}} · Hello LLM</title><link rel="license" href="../../code/visuals/reading_site/tensor3d-LICENSE.txt">
<style>
:root{color-scheme:light;--paper:#f5f7fb;--panel:#fff;--ink:#222a35;--muted:#627082;--line:#dce3ed;--blue:#3267a4;--purple:#8056a5;--teal:#187b79;--soft:#edf3fa;--field:#f7f9fc}
:root[data-theme=dark]{color-scheme:dark;--paper:#151a22;--panel:#1d2530;--ink:#e5eaf1;--muted:#a8b5c6;--line:#364353;--blue:#99bde9;--purple:#c6a0e8;--teal:#75cbbf;--soft:#293b46;--field:#202b39}
*{box-sizing:border-box}body{margin:0;background:var(--paper);color:var(--ink);font:14px/1.5 'Hiragino Sans GB','PingFang SC','Microsoft YaHei',Arial,sans-serif}main{max-width:1220px;margin:auto;padding:14px 22px 20px}a{color:var(--teal);text-underline-offset:3px}.top{display:flex;align-items:center;justify-content:space-between;gap:12px;font-size:12px}.eyebrow{font-size:10px;letter-spacing:.1em;color:var(--muted)}h1{font-size:27px;line-height:1.2;margin:12px 0 6px;letter-spacing:-.03em}.lead{font-size:13px;color:var(--muted);margin:0 0 13px}.lab-shell{height:min(650px,calc(100svh - 129px));min-height:430px;border:1px solid var(--line);border-radius:10px;background:var(--panel);overflow:hidden;display:grid;grid-template-rows:auto minmax(0,1fr)}button,select,input{font:inherit;color:inherit;border:1px solid var(--line);border-radius:5px;background:var(--panel);min-height:34px}button{cursor:pointer;padding:5px 10px}button:hover{border-color:var(--teal)}button:disabled{opacity:.35;cursor:default}button[aria-pressed=true],button[aria-selected=true]{background:var(--soft);color:var(--teal);border-color:var(--teal)}button:focus-visible,select:focus-visible,input:focus-visible,a:focus-visible,canvas:focus-visible,summary:focus-visible{outline:3px solid var(--blue);outline-offset:2px}.toolbar{display:grid;grid-template-columns:155px minmax(0,1fr) 125px auto;align-items:end;gap:8px;padding:11px 14px;border-bottom:1px solid var(--line)}.control{display:flex;flex-direction:column;gap:4px;min-width:0}.control>span{font-size:10px;color:var(--muted)}.control select{width:100%;min-width:0;padding:5px 7px;font-size:12px}.coordinate-stepper{display:flex;align-items:center;gap:4px}.coordinate-stepper input{width:52px;text-align:center;padding:4px;font-family:Menlo,Consolas,monospace}.coordinate-stepper button{padding:4px 8px;width:30px}.stage-stepper{display:flex;gap:4px}.stage-stepper button{width:34px;padding:4px}.workspace{display:grid;grid-template-columns:minmax(0,1.1fr) minmax(350px,1fr);min-height:0}.scene-panel{display:grid;grid-template-rows:auto minmax(0,1fr) auto auto;min-height:0;border-right:1px solid var(--line)}.scene-head{display:flex;align-items:center;justify-content:space-between;gap:6px;padding:10px 12px 5px}.segmented{display:flex;gap:4px}.segmented button{font-size:11px;min-height:31px;padding:4px 8px}.shape{font:11px/1.5 Menlo,Consolas,monospace;color:var(--muted);white-space:nowrap}.viewport{position:relative;min-height:0;overflow:hidden}.viewport canvas{display:block;width:100%;height:100%;touch-action:pan-y;outline-offset:-3px}.viewport.is-orbit canvas{touch-action:none;cursor:grab}.viewport.is-orbit canvas:active{cursor:grabbing}.scene-tip{position:absolute;left:13px;right:13px;bottom:5px;color:var(--muted);font-size:10px;pointer-events:none;text-align:center}.fallback{display:none;height:100%;align-items:center;justify-content:center;padding:18px;color:var(--muted);font-size:12px;text-align:center}.viewport.failed canvas,.viewport.failed .scene-tip{display:none}.viewport.failed .fallback{display:flex}.view-tools{display:flex;justify-content:space-between;align-items:center;padding:4px 12px;gap:8px}.view-tools button{font-size:11px;min-height:30px;padding:4px 8px}.legend{display:flex;align-items:center;gap:7px;color:var(--muted);font-size:9px}.color-strip{width:52px;height:5px;background:linear-gradient(to right,#8056a5,#f5f7fb,#187b79)}.axis-note{font-size:10px;color:var(--muted);padding:5px 12px 10px;margin:0}.inspector{display:grid;grid-template-rows:auto auto minmax(0,1fr);min-height:0;overflow:hidden}.readout{padding:12px 15px 10px;background:var(--field);border-bottom:1px solid var(--line)}.readout-top{display:flex;align-items:center;justify-content:space-between;gap:8px;font-size:10px;color:var(--muted)}.readout-value{font:600 29px/1.25 Menlo,Consolas,monospace;letter-spacing:-.04em;color:var(--blue);margin:4px 0}.equation{font:11px/1.6 Menlo,Consolas,monospace;overflow-wrap:anywhere}.readout-note{font-size:10px;line-height:1.6;color:var(--muted);margin:5px 0 0}.tablist{display:flex;border-bottom:1px solid var(--line);padding:5px 10px;gap:4px}.tablist button{flex:1;font-size:11px;padding:5px 7px;min-height:32px}.tab-panel{padding:11px 14px;overflow:auto;min-height:0;overscroll-behavior:contain;scrollbar-width:thin}.tab-panel[hidden]{display:none}.panel-note{font-size:10px;color:var(--muted);margin:0 0 8px;line-height:1.6}.coordinate-grid{display:grid;grid-template-columns:repeat(8,minmax(0,1fr));gap:4px}.coordinate-grid button{border-radius:3px;min-height:34px;padding:3px 1px;min-width:0;text-align:center;font:9px/1.4 Menlo,Consolas,monospace;color:var(--ink)}.coordinate-grid button b{display:block;font-size:9px;font-weight:400;opacity:.65}.coordinate-grid button[aria-pressed=true]{outline:2px solid var(--ink);outline-offset:0;border-color:var(--ink)}.panel-controls{display:flex;align-items:end;gap:10px;margin-bottom:9px}.panel-controls label{min-width:0;flex:1;font-size:10px;color:var(--muted)}.panel-controls select,.panel-controls input{display:block;width:100%;margin-top:4px;font-size:11px;min-height:30px;padding:4px 7px}.attention-bars{display:flex;align-items:end;gap:3px;height:104px;margin:5px 0 8px;padding-top:20px}.attention-bar{flex:1;display:flex;flex-direction:column;align-items:center;justify-content:end;min-width:0;height:100%;padding:0 1px;border:0;border-radius:0;background:transparent;font-size:9px;min-height:0}.attention-bar .bar{display:block;width:100%;min-height:2px;background:var(--blue);border-radius:2px 2px 0 0}.attention-bar .bar.blocked{background:repeating-linear-gradient(135deg,#c5ccd6,#c5ccd6 3px,#929ead 3px,#929ead 4px);height:8px!important}.attention-bar[aria-pressed=true]{outline:2px solid var(--teal);outline-offset:2px;background:transparent}.attention-bar strong{font:8px/1.5 Menlo,Consolas,monospace;white-space:nowrap}.attention-bar small{font-size:7px;opacity:.7}.detail-equation{font:10px/1.7 Menlo,Consolas,monospace;background:var(--field);border-radius:4px;padding:7px;overflow-wrap:anywhere;margin:6px 0}.top-candidates{display:grid;gap:5px}.candidate-row{display:grid;grid-template-columns:30px minmax(0,1fr) 75px;align-items:center;gap:8px;width:100%;min-height:31px;padding:4px 8px;font-size:12px;text-align:left}.candidate-row .track{height:6px;background:var(--soft)}.candidate-row .fill{height:100%;background:var(--teal)}.candidate-row small{text-align:right;font:10px Menlo,Consolas,monospace}.candidate-picker{width:100%;font-size:11px;min-height:32px;margin-top:8px;padding:5px}.source-note{color:var(--muted);font-size:11px;margin-top:13px}.source-note summary{cursor:pointer}.source-note p{margin:7px 0;line-height:1.7}.source-note code{font:9px Menlo,Consolas,monospace;overflow-wrap:anywhere}.sr-only{position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;border:0}
@media(max-width:700px){main{padding:10px 12px 16px}h1{font-size:23px;margin:10px 0 5px}.lead{font-size:11px;margin-bottom:10px}.lab-shell{height:calc(100svh - 116px);min-height:490px;max-height:800px}.toolbar{grid-template-columns:105px minmax(0,1fr);gap:6px 9px;padding:8px 10px}.control>span{font-size:9px;line-height:1.2}.control{gap:3px}.toolbar select{min-height:31px;font-size:10px;padding:4px}.coordinate-control{flex-direction:row;align-items:center;grid-column:1;gap:5px;width:145px}.coordinate-control>span:first-child{max-width:38px}.coordinate-stepper{gap:2px;flex-shrink:0}.coordinate-stepper input{width:34px;min-height:28px;font-size:10px;padding:2px;-moz-appearance:textfield}.coordinate-stepper input::-webkit-inner-spin-button{-webkit-appearance:none}.coordinate-stepper button{width:28px;min-height:28px;padding:2px}.stage-stepper{justify-content:flex-end;grid-column:2;grid-row:2}.stage-stepper button{width:32px;min-height:28px}.workspace{grid-template-columns:1fr;grid-template-rows:minmax(155px,.43fr) minmax(230px,.57fr)}.scene-panel{position:relative;border-right:0;border-bottom:1px solid var(--line);grid-template-rows:minmax(0,1fr)}.scene-panel .viewport{grid-row:1;grid-column:1}.scene-panel .scene-head{position:absolute;top:0;left:0;right:0;z-index:2}.scene-panel .view-tools{position:absolute;bottom:0;left:0;right:0;z-index:2}.scene-head{padding:7px 10px 2px}.segmented button{min-height:28px;font-size:9px;padding:3px 6px}.shape{font-size:9px}.scene-tip{display:none}.view-tools{padding:2px 10px 5px}.view-tools button{font-size:9px;min-height:27px;padding:3px 6px}.legend{font-size:8px;gap:4px}.color-strip{width:35px}.axis-note{display:none}.readout{padding:8px 11px}.readout-top{font-size:9px}.readout-value{font-size:25px;margin:2px 0}.equation{font-size:9px}.readout-note{font-size:9px;line-height:1.5;margin-top:3px}.tablist{padding:4px 7px;gap:4px}.tablist button{font-size:10px;min-height:29px;padding:3px 5px}.tab-panel{padding:8px 10px}.coordinate-grid{gap:3px}.coordinate-grid button{min-height:34px;font-size:8px}.coordinate-grid button b{font-size:8px}.source-note{font-size:10px}.panel-note{font-size:9px}.attention-bars{height:92px}.candidate-row{min-height:29px}.panel-controls{margin-bottom:5px}}
@media(max-height:650px){main{padding-top:8px}.top{font-size:10px}h1{font-size:21px;margin:7px 0 8px}.lead{display:none}.lab-shell{height:calc(100svh - 82px);min-height:350px;max-height:none}.source-note{margin-top:9px}.toolbar{padding-top:7px;padding-bottom:7px}.readout-note{display:none}.readout-value{font-size:24px}.readout{padding-top:8px;padding-bottom:7px}}
@media(max-width:700px) and (max-height:650px){.workspace{grid-template-rows:minmax(135px,.40fr) minmax(205px,.60fr)}.lab-shell{min-height:430px}.scene-head{padding-top:4px}.scene-tip{display:none}.coordinate-grid button{min-height:30px}.toolbar{gap:5px 8px}.view-tools{padding-bottom:3px}}
@media(prefers-reduced-motion:reduce){*{scroll-behavior:auto!important}}
</style></head><body><main id="lab" data-render-state="loading">
<nav class="top"><a href="{{article}}">{{back}}</a><span class="eyebrow">{{eyebrow}}</span></nav><header><h1>{{title}}</h1><p class="lead">{{lead}}</p></header>
<section class="lab-shell" aria-label="{{title}}"><div class="toolbar">
<label class="control"><span>{{position}}</span><select id="position"></select></label>
<label class="control"><span>{{stage}}</span><select id="stage"></select></label>
<label class="control coordinate-control"><span id="coordinate-label">{{coordinate}}</span><span class="coordinate-stepper"><button id="coordinate-previous" type="button" aria-label="{{coordinate}} −">−</button><input id="coordinate" type="number" min="0" max="63" value="0" aria-label="{{coordinate}} 0–63"><button id="coordinate-next" type="button" aria-label="{{coordinate}} +">+</button></span></label>
<div class="stage-stepper"><button id="previous" aria-label="{{previous}}">←</button><button id="next" aria-label="{{next}}">→</button></div>
</div><div class="workspace">
<section class="scene-panel" aria-label="{{scene}}"><div class="scene-head"><div class="segmented"><button id="overview" aria-pressed="false">{{overview}}</button><button id="focus" aria-pressed="true">{{focus}}</button></div><span class="shape" id="shape">[1, 14, 64]</span></div>
<div class="viewport" id="viewport"><canvas id="scene" tabindex="0" aria-label="{{scene}}"></canvas><span id="scene-tip" class="scene-tip">{{focusHint}}</span><div class="fallback" role="status">{{fallback}}</div></div>
<div class="view-tools"><div class="segmented"><button id="orbit" aria-pressed="false">{{orbit}}</button><button id="reset-view">{{reset}}</button></div><span class="legend"><span>{{negative}}</span><span class="color-strip"></span><span>{{positive}}</span><span id="scale-label">±0.0</span></span></div><p class="axis-note" id="axis-note">{{axisNote}}</p></section>
<section class="inspector" aria-label="{{coordinate}}"><div class="readout" aria-live="polite"><div class="readout-top"><span id="readout-address"></span><span id="readout-extra"></span></div><div id="readout-value" class="readout-value"></div><div id="equation" class="equation"></div><p id="readout-note" class="readout-note"></p></div>
<div class="tablist" role="tablist"><button id="tab-coordinates" role="tab" aria-selected="true" aria-controls="panel-coordinates">{{coordinates}}</button><button id="tab-attention" role="tab" aria-selected="false" aria-controls="panel-attention" tabindex="-1">{{attention}}</button><button id="tab-output" role="tab" aria-selected="false" aria-controls="panel-output" tabindex="-1">{{output}}</button></div>
<div id="panel-coordinates" class="tab-panel" role="tabpanel" aria-labelledby="tab-coordinates"><p class="panel-note" id="coordinate-note">{{axisNote}}</p><div id="product-equation" class="detail-equation" hidden></div><div id="coordinate-grid" class="coordinate-grid"></div></div>
<div id="panel-attention" class="tab-panel" role="tabpanel" aria-labelledby="tab-attention" hidden><div class="panel-controls"><label>{{head}}<select id="head"><option value="0">0</option><option value="1">1</option></select></label><label>{{headCoordinate}}<input id="head-coordinate" type="number" min="0" max="31" value="0"></label></div><div id="attention-bars" class="attention-bars"></div><div id="attention-equation" class="detail-equation"></div><p class="panel-note">{{causal}}</p><p class="panel-note">{{readNote}}</p></div>
<div id="panel-output" class="tab-panel" role="tabpanel" aria-labelledby="tab-output" hidden><p class="panel-note">{{probabilityNote}}</p><div id="top-candidates" class="top-candidates"></div><select id="candidate" class="candidate-picker" aria-label="{{candidate}}"></select><div id="candidate-equation" class="detail-equation"></div><button id="show-products">{{coordinates}} ↗</button></div>
</section></div></section>
<details class="source-note"><summary>{{detail}}</summary><p>{{snapshot}}</p><p>{{axisNote}} {{outputAxis}}</p><p>{{coordinateNote}} {{scale}}. {{controlsHint}}</p><p><a href="../../code/artifacts/first_run/forward_trace.json">{{source}}</a> · <a href="{{staticPath}}">{{staticLink}}</a></p><p>{{digest}} <code id="digest"></code></p></details>
<p id="status" class="sr-only" role="status">{{loading}}</p><noscript><p>{{noScript}} <a href="{{staticPath}}">{{staticLink}}</a></p></noscript></main>
<script id="model-data" type="application/json">{{payload}}</script><script src="../../code/visuals/reading_site/model3d.js" defer onerror="document.getElementById('viewport').classList.add('failed')"></script>
</body></html>
